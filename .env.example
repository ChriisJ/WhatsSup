# ============================================================
# MedTracker - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ---- Core ----
TZ=Europe/Berlin
SECRET_KEY=change-me-to-a-long-random-string
APP_PORT=8000
APP_HOST=0.0.0.0

# ---- Database ----
DATABASE_URL=sqlite:///./data/medtracker.db

# ---- Auth (multi-user) ----
# Single user gets auto-created on first start with this name/password
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme

# ---- Reminder behavior ----
REMINDER_INTERVAL_MINUTES=30
REMINDER_QUIET_HOURS_START=22
REMINDER_QUIET_HOURS_END=7

# ---- Discord Bot ----
# Create a bot at https://discord.com/developers/applications
# Enable MESSAGE CONTENT INTENT + SERVER MEMBERS INTENT
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Restrict to specific guild (server) ID; empty = all
DISCORD_GUILD_ID=
# Channel ID where reminders go (leave empty = use DM to user)
DISCORD_CHANNEL_ID=
# Discord user IDs allowed to interact (comma-separated). Empty = all in guild.
DISCORD_ALLOWED_USERS=

# ---- Telegram Bot ----
# Talk to @BotFather to create a bot and get the token
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated list of chat IDs allowed to interact
TELEGRAM_ALLOWED_CHATS=

# ---- WhatsApp via CallMeBot (free, unofficial) ----
# 1. Save +34 644 59 71 47 in contacts
# 2. Send "I allow callmebot to send me messages"
# 3. You'll get an API key
# Docs: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Note: WhatsApp via CallMeBot does NOT support interactive buttons.
# Confirmations via WhatsApp must be done by replying with a keyword or via the web UI.
